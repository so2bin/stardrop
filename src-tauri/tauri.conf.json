{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarDrop",
  "version": "1.0.0",
  "identifier": "com.stardrop.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "星传 StarDrop",
        "width": 1140,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#08090D",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "手机照片秒传电脑",
    "longDescription": "星传 StarDrop：同一 WiFi 下用手机浏览器扫码传图到电脑，支持拖拽、相册、拍照与文件回传。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
